# Copy to .env to override defaults. No API keys are needed.
PORT=3000
# Your public https URL (makes the session cookie Secure).
PUBLIC_URL=
# NEAR sign-in: mainnet or testnet. Match nearNetwork in index.html.
NEAR_NETWORK=mainnet
# Optional NEAR RPC URL(s), comma separated (default: FastNEAR, then the official RPC).
NEAR_RPC=
# On-chain RNG (Solana: ORAO VRF). mainnet-beta or devnet.
SOLANA_CLUSTER=mainnet-beta
# RPC the server uses to read ORAO randomness accounts.
SOLANA_RPC=
# RPC handed to browsers to send the ORAO request (defaults to SOLANA_RPC).
SOLANA_PUBLIC_RPC=
# NEAR RNG contract account (deploy contracts/near-rng first).
NEAR_RNG_CONTRACT=
