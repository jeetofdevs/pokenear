# StonkPacks runs on Solana by default (CHAIN=solana). Packs are paid in SOL to TREASURY_SOL.
CHAIN=solana
# Public address of the Solana wallet that receives SOL pack payments. It also opens packs free
# and sees /admin. Empty = packs stay closed.
TREASURY_SOL=
# Optional: Solana RPC URL(s), comma separated (default: api.mainnet-beta.solana.com, publicnode).
SOLANA_RPC=
# Optional: backup SOL/USD price used only if every live price source fails.
SOL_USD=
# Optional: more Solana wallets for free openings / the admin page (comma separated).
DEV_ACCOUNTS=
ADMIN_ACCOUNTS=

# ---- NEAR setup (only with CHAIN=near) ----
# Copy to .env to override defaults.
PORT=3000
# Your public https URL (makes the session cookie Secure).
PUBLIC_URL=
# NEAR network for sign-in and payments: mainnet or testnet. Match nearNetwork in index.html.
NEAR_NETWORK=mainnet
# Optional NEAR RPC URL(s), comma separated (default: FastNEAR, then the official RPC).
NEAR_RPC=
# Interaction wallet running contracts/near-rng (receives NEAR, pays buybacks).
GAME_ACCOUNT=nearpacks.near
# Function-call access key of GAME_ACCOUNT limited to payout() (ed25519:...). Empty = buyback closed.
PAYOUT_KEY=
# Wallets that open packs without paying (recorded as dev openings). Comma separated.
DEV_ACCOUNTS=nearpacks.near
