# Copy to .env to override defaults. No API keys are needed.
PORT=3000
# Your public https URL (makes the session cookie Secure).
PUBLIC_URL=
# NEAR sign-in: mainnet or testnet. Match nearNetwork in index.html.
NEAR_NETWORK=mainnet
# Optional custom NEAR RPC (defaults to the official one for NEAR_NETWORK).
NEAR_RPC=
